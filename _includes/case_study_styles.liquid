<!-- Styles for the AiTenea case study (_projects/aitenea*.md). Theme variables keep light/dark mode working. -->
<style>
  :root {
    --ait-si: #1f9e89;
    --ait-vl: #e07a2e;
    --ait-caba: #5b6fd6;
  }
  /* Numbered section titles with a divider */
  .post article {
    counter-reset: ait-section;
  }
  .post article h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--global-divider-color);
    counter-increment: ait-section;
  }
  .post article h2::before {
    content: counter(ait-section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--global-theme-color);
  }
  .post article h3 {
    margin-top: 1.75rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .ait-hero {
    border: 1px solid var(--global-divider-color);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    background: var(--global-card-bg-color);
  }
  .ait-brand {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .ait-logo-dark {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    background: #1e2235;
  }
  .ait-logo-dark img {
    height: 26px;
  }
  .ait-by {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }
  .ait-friwi {
    height: 30px;
  }
  .ait-lead {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .ait-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--global-divider-color);
  }
  .ait-fact span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }
  .ait-fact strong {
    font-weight: 500;
  }
  @media (max-width: 767px) {
    .ait-map figure {
      max-width: 320px;
      margin: 0 auto;
    }
  }
  .ait-muni {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }
  .ait-swatch {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.35rem;
    border-radius: 3px;
  }
  .ait-count {
    margin-left: auto;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--global-text-color-light);
  }
  .ait-total {
    margin-top: 1rem;
  }
  .ait-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 1.5rem;
  }
  .ait-feature {
    padding: 1rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
  }
  .ait-feature i {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
    color: var(--global-theme-color);
  }
  .ait-feature p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--global-text-color-light);
  }
  .ait-metric {
    height: 100%;
    padding: 1rem 0.75rem;
    border: 1px solid var(--global-divider-color);
    border-top: 3px solid var(--global-theme-color);
    border-radius: 10px;
  }
  .ait-metric-value {
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--global-theme-color);
  }
  .ait-metric-label {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }
  .ait-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 1rem 0 1.5rem;
    padding: 0;
    list-style: none;
    counter-reset: ait-step;
  }
  @media (min-width: 768px) {
    .ait-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ait-steps li {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.75rem 0.9rem 0.75rem 3rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    font-size: 0.9rem;
    line-height: 1.3;
    counter-increment: ait-step;
  }
  .ait-steps li::before {
    content: counter(ait-step);
    position: absolute;
    left: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--global-hover-text-color);
    background: var(--global-theme-color);
  }
  .ait-steps li:last-child {
    border-color: var(--global-theme-color);
    font-weight: 500;
  }
  .ait-pills span {
    display: inline-block;
    margin: 0 0.35rem 0.5rem 0;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    font-size: 0.85rem;
  }
</style>
